# Credenciais do Playwright MCP. Copie para .playwright/secrets.env e
# preencha. O secrets.env é ignorado pelo git e bloqueado para a IA
# (.claude/settings.json).
#
# A IA digita o NOME da chave (ex.: KOI_DEV_SENHA) e o MCP põe o valor; nas
# respostas, o valor aparece como <secret>KOI_DEV_SENHA</secret>.
#
# Senha com # (ou espaço, aspas): coloque entre aspas simples, ex.
# KOI_DEV_SENHA='abc#123'. Sem aspas, tudo a partir do # vira comentário.

# Dev local (http://localhost:3009, Supabase local): conta sintética, nunca dado real.
KOI_DEV_EMAIL=dev@koinonya.test
KOI_DEV_SENHA=

# Staging (https://koinonya-staging.up.railway.app): a sua conta de verdade.
KOI_STAGING_EMAIL=
KOI_STAGING_SENHA=
