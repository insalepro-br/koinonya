{
  "name": "koinonya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --define:__PROD_BUILD__=true --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "capture:firebase": "pnpm --dir scripts/firebase-capture capture",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts && pnpm --dir scripts/firebase-capture gen:columns",
    "db:import:firebase": "pnpm --dir scripts/firebase-capture import:local --reset",
    "test:isolation": "tsx scripts/security/isolation.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "railway": "^3.17.0",
    "supabase": "3.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0"
}
