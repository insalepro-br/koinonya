# Copie para .env (nunca commitar .env).

# ---------- Servidor (Express) ----------
PORT=3000
# Autenticação das rotas /api: firebase (atual) ou supabase (após a migração)
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=gen-lang-client-0519033383
# SUPABASE_URL=https://<ref>.supabase.co

# Gemini (somente no servidor). Sem chave, a API responde com textos padrão.
GEMINI_API_KEY=
# Confirmar nome do modelo disponível na conta antes de produção.
GEMINI_MODEL=gemini-4-hydrogen

# ---------- Front (Vite: só variáveis VITE_* chegam ao navegador) ----------
# true = cria dados de demonstração automaticamente no primeiro login. NUNCA em produção.
VITE_DEMO_SEED=false
