# Copie para .env (nunca commitar .env).

# ---------- Supabase ----------
# Local: `pnpm db:start` e `pnpm db:status` mostram URL e chaves.
# Nuvem: Project Settings > API. Use só a chave PUBLICÁVEL no front; a secreta nunca sai do servidor.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Local: chave padrão de todo Supabase local (pública, só desenvolvimento).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Servidor (valida o JWT do login via JWKS). Mesmo valor de VITE_SUPABASE_URL.
SUPABASE_URL=http://127.0.0.1:54321

# Login com Google no Supabase local: credenciais em supabase/.env (modelo em supabase/.env.example).

# ---------- Servidor (Express) ----------
PORT=3000

# Gemini (somente no servidor). Sem chave, a API responde com textos padrão.
GEMINI_API_KEY=
# Confirmar nome do modelo disponível na conta antes de produção.
GEMINI_MODEL=gemini-4-hydrogen

# ---------- Front ----------
# true = cria dados de demonstração automaticamente no primeiro login. NUNCA em produção.
VITE_DEMO_SEED=false
